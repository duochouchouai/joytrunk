{
  "name": "joytrunk-desktop",
  "version": "1.0.0",
  "description": "JoyTrunk Desktop — 快乐象鼻桌面端，悬浮窗与主窗口，启动时自动运行 joytrunk server 与 gateway",
  "main": "main.js",
  "author": "JoyTrunk",
  "scripts": {
    "round-icon": "node scripts/round-icon.js",
    "prestart": "npm run round-icon",
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "koffi": "^2.8.0",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.joytrunk.desktop",
    "productName": "JoyTrunk",
    "icon": "../imgs/logo-white-rounded.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main.html",
      "index.html",
      "preload.js",
      "preload-main.js",
      "renderer.js",
      "scripts",
      "assets"
    ],
    "extraResources": [
      { "from": "../imgs", "to": "imgs" }
    ],
    "win": {
      "signAndEditExecutable": false
    }
  }
}
