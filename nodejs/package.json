{
  "name": "joytrunk-official",
  "version": "0.1.0",
  "description": "JoyTrunk 官方后端：注册用户、IM、LLM Router（与本地 32901 gateway 解耦）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:android": "cross-env HOST=0.0.0.0 node server.js",
    "start:debug": "cross-env DEBUG_WS=1 node server.js",
    "test": "node --test tests/*.js",
    "seed": "node scripts/seed-test-users.js",
    "debug:im": "node scripts/debug-im-visibility.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.0",
    "ws": "^8.18.0"
  }
}
