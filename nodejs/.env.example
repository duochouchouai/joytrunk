# PostgreSQL（.env 中配置，复制为 .env 后填写）
# 方式一：完整连接串
DATABASE_URL=postgres://postgres:123456@localhost:5432/joytrunk
# 方式二：拆分配置（不设 DATABASE_URL 时使用）
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=123456
# PG_DATABASE=joytrunk
# PG_SSL=false
# PG_POOL_MAX=10

# Redis（验证码存储，必填否则发码/登录校验不可用）
REDIS_URL=redis://localhost:6379
# 或拆分配置：
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# 验证码有效期与节流（可选，默认 300s / 60s）
# CODE_EXPIRE_SECONDS=300
# CODE_THROTTLE_SECONDS=60

# 阿里云短信（发真实验证码时必填）
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=你的AccessKeyId
# SMS_ACCESS_KEY_SECRET=你的AccessKeySecret
# SMS_SIGN_NAME=控制台申请的签名名称
# SMS_TEMPLATE_CODE=控制台申请的模板Code（需含变量 code）
# SMS_REGION_ID=cn-hangzhou
# SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 邮件验证码（可选；不配置则控制台打印验证码）
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=
# MAIL_DEV_ACCEPT_ALL=true   # 仅当未配置 MAIL_HOST 时生效：开发环境允许任意验证码登录

PORT=32891
HOST=localhost
NODE_ENV=development
JWT_SECRET=dev-secret-change-in-production

# 测试用户（npm run seed 写入；用于开发/联调）
# test1@test.local / test123456  测试用户A
# test2@test.local / test123456  测试用户B

# 雪花算法 uid（多实例部署时每实例设不同 WORKER_ID 避免重复）
# SNOWFLAKE_WORKER_ID=0
# SNOWFLAKE_DATACENTER_ID=0

# IM 数据清理（Phase 2/3 后定时任务使用）
# CLEANUP_DELETED_CONVERSATIONS_AFTER_DAYS=90
# CLEANUP_READ_MESSAGES_AFTER_DAYS=180
