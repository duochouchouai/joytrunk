# JoyTrunk CLI 可选环境变量（开发/测试用）
# 复制为 .env 并填写后，执行 joytrunk onboard 时可选择导入到 ~/.joytrunk/config.json
# 勿提交 .env（已在 .gitignore）

# ---------- 端口（仅由此文件配置，不读 config.json）----------
JOYTRUNK_SERVER_PORT=32901
JOYTRUNK_A2A_PORT=32900

# ---------- 自有 LLM（OpenAI 兼容）----------
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# ---------- 可选：自定义 LLM 变量名（与上二选一）----------
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://api.openai.com/v1
# CUSTOM_LLM_MODEL=gpt-3.5-turbo

# ---------- 可选：JoyTrunk Router（未配置自有 LLM 时使用）----------
# JOYTRUNK_ROUTER_URL=https://your-router/v1

# ---------- 可选：MiniMax embedding（使用 MiniMax 记忆时需填，避免 2013）----------
# MINIMAX_GROUP_ID=
